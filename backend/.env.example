# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://expenses:expenses@localhost:5432/expenses
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
# JSON list of allowed browser origins (default: the Vite dev server)
# CORS_ORIGINS=["http://localhost:5173"]
# Signs login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me
# true in production (HTTPS only cookies); false for http:// dev and Wi-Fi testing
# COOKIE_SECURE=false
# Where the browser sends the refresh cookie: /auth on your laptop, /api/auth in
# production (the Vercel proxy puts the API under /api). See DEPLOY.md.
# COOKIE_PATH=/auth
